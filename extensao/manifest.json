{
  "manifest_version": 3,
  "name": "ImovelMap Radar",
  "version": "0.4.0",
  "description": "Captura imoveis dos portais enquanto voce navega e revela o endereco que o anuncio esconde.",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "sidePanel",
    "tabs"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "host_permissions": [
    "https://imovelmap.com/*",
    "https://superag.vercel.app/*",
    "https://jmtrkygcndaqnrgobnqo.supabase.co/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://imovelmap.com/*",
      "https://superag.vercel.app/*"
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "ui/popup.html",
    "default_title": "ImovelMap Radar",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "side_panel": {
    "default_path": "ui/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://imovelmap.com/*",
        "https://superag.vercel.app/*"
      ],
      "js": [
        "core/conectar.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "core/net-hook.js"
      ],
      "matches": [
        "https://*/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "options_page": "ui/agente.html"
}
